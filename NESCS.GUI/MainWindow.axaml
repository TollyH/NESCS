<Window x:Class="NESCS.GUI.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="using:System"
        mc:Ignorable="d"
        Title="NESCS" UseLayoutRounding="True" SizeToContent="WidthAndHeight" CanResize="False" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="_System">
                <MenuItem Header="_Load ROM..." InputGesture="Ctrl+O" Click="LoadItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/cassette.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Load ROM (_No Reset)..." InputGesture="Ctrl+Shift+O" Click="LoadNoResetItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/cassette--exclamation.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Start/_Resume Emulation" InputGesture="Ctrl+P" Click="StartItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/control.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pause Emulation" InputGesture="Ctrl+Shift+P" Click="StopItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/control-pause.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _Frame" InputGesture="Ctrl+." Click="FrameStepItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/control-stop.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Soft Reset (Reset Button)" InputGesture="Ctrl+R" Click="SoftResetItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/arrow-circle-double.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Hard Reset (Power Cycle)" InputGesture="Ctrl+Shift+R" Click="HardResetItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/control-power.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="scaleMenuItem" Header="_Scale">
                    <MenuItem Header="_1x" ToggleType="Radio" IsChecked="True" Click="ScaleItem_Click">
                        <MenuItem.Tag>
                            <sys:Double>1.0</sys:Double>
                        </MenuItem.Tag>
                    </MenuItem>
                    <MenuItem Header="_2x" ToggleType="Radio" Click="ScaleItem_Click">
                        <MenuItem.Tag>
                            <sys:Double>2.0</sys:Double>
                        </MenuItem.Tag>
                    </MenuItem>
                    <MenuItem Header="_4x" ToggleType="Radio" Click="ScaleItem_Click">
                        <MenuItem.Tag>
                            <sys:Double>4.0</sys:Double>
                        </MenuItem.Tag>
                    </MenuItem>
                    <MenuItem Header="_8x" ToggleType="Radio" Click="ScaleItem_Click">
                        <MenuItem.Tag>
                            <sys:Double>8.0</sys:Double>
                        </MenuItem.Tag>
                    </MenuItem>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="_Nametables" InputGesture="Ctrl+Alt+N" Click="OpenNametableDebugItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/map.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Performance" InputGesture="Ctrl+Alt+P" Click="OpenPerformanceDebugItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/clock.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Audio" InputGesture="Ctrl+Alt+A" Click="OpenAudioDebugItem_Click">
                    <MenuItem.Icon>
                        <Image Source="avares://NESCS.GUI/Resources/MenuIcons/music-beam.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Image x:Name="nesDisplay" Grid.Row="1" RenderOptions.BitmapInterpolationMode="None"/>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Label x:Name="fpsStatusLabel" Content="FPS: Paused" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
