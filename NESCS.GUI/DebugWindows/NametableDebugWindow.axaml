<Window x:Class="NESCS.GUI.DebugWindows.NametableDebugWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nametable Debug" SizeToContent="WidthAndHeight" CanResize="False" UseLayoutRounding="True" Icon="avares://NESCS.GUI/Resources/MenuIcons/map.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="10" BorderThickness="1" BorderBrush="Black">
            <Grid x:Name="displayContainer">
                <Image x:Name="nametableDisplay"/>
                <Rectangle HorizontalAlignment="Center" Width="1" Fill="Gray"/>
                <Rectangle VerticalAlignment="Center" Height="1" Fill="Gray"/>
                <Canvas x:Name="scrollOverlayContainer" ClipToBounds="True">
                    <Rectangle x:Name="scrollOverlay" StrokeThickness="2" Stroke="Magenta" Fill="#22FF00FF" Width="256" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Rectangle x:Name="scrollOverlayWraparoundHorizontal" IsVisible="False" StrokeThickness="2" Stroke="Magenta" Fill="#22FF00FF" Width="256" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Rectangle x:Name="scrollOverlayWraparoundVertical" IsVisible="False" StrokeThickness="2" Stroke="Magenta" Fill="#22FF00FF" Width="256" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Rectangle x:Name="scrollOverlayWraparoundBoth" IsVisible="False" StrokeThickness="2" Stroke="Magenta" Fill="#22FF00FF" Width="256" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Canvas>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1">
            <CheckBox x:Name="scrollOverlayVisible" Margin="10,10,10,5" Content="Show visible scroll area" IsChecked="True" IsCheckedChanged="scrollOverlayVisible_IsCheckedChanged"/>
            <CheckBox x:Name="showTruePaletteEntries" Margin="10,5" Content="Show true palette colours" IsChecked="False"/>
        </StackPanel>
    </Grid>
</Window>
