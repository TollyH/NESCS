<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <Title>NESCS.GUI</Title>
    <Description>A hobby NES emulator made with C# and Avalonia</Description>
    <Copyright>Copyright © 2025-2026 Ptolemy Hill</Copyright>
    <PackageProjectUrl>https://github.com/TollyH/NESCS</PackageProjectUrl>
    <Company>Tolly Hill</Company>
    <Authors>Tolly Hill</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/TollyH/NESCS</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\**\*.png" />
    <AvaloniaResource Include="Resources\**\*.png" />
    <None Remove="Resources\*.png" />
    <AvaloniaResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NESCS\NESCS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
